{
  "name": "agentops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first mission control for orchestrating, reviewing and auditing AI coding agents",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --import tsx src/server/index.ts",
    "dev": "node --import tsx --watch src/server/index.ts",
    "dev:ui": "vite",
    "build": "npm run typecheck && vite build",
    "test": "node --import tsx --test \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "test:watch": "node --import tsx --test --watch \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests docs .github *.ts *.json *.md",
    "format:check": "prettier --check src tests docs .github *.ts *.json *.md"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Figo5/agentops.git"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
